#include "PlotCamera.h"


int main(int argc, char **argv){
        if(argc < 2){
                cout << "Too few arguments; please include the date data directory to summarize" << endl;
                        return 1;
	}
    
        // Get the Arguments
        std::string folString = argv[1];
        std::string simrun = argv[2];

        std::string mount = argv[3];
    
        if (mount == "y"){
                std::cout << "using mounted directory path" << std::endl;
                mnt="/mnt/";
                dataDir = "/mnt/simdata/roots/diffuse/";
                outDir = "/mnt/DataAnalysis/SimulationAnalysis/data/";
        } else if (mount != "n"){
                std::cout << "using specific directory path" << std::endl;
                mnt=mount.c_str();
                dataDir = Form("%ssimdata/roots/diffuse/",mnt.c_str());
                outDir = Form("%sDataAnalysis/SimulationAnalysis/data/",mnt.c_str());
        }

        std::string FolderPath = Form("%s%s_%s/GROPT/Tilt_91.5600000/",dataDir.c_str(),folString.c_str(),simrun.c_str());
        cout << FolderPath << endl;
        std::vector<std::string> fileNamesVec;
        fileNamesVec=util->GetFilesInDirectory(FolderPath,".root");
        for (auto i: fileNamesVec)
                std::cout << i << ' ';
        cout << endl;
        if (mkdir(Form("%s%s",outDir.c_str(),folString.c_str()), 0775) == -1)
        {
                cout << "Error : possibly directory already exists" << endl;
        } else{
                cout << "Directory created" <<  endl;
        }
        cout << "Output Folder: " << Form("%s%s/",outDir.c_str(),folString.c_str()) << endl;

        if (fileNamesVec.size()==0){
                cout << "Folder empty moving on..." << endl;
                cout << "Completed!"<< endl;
                return 0;
        }
        
        for(int f = 0; f<static_cast<int>(fileNamesVec.size()); f++){
                std::string FilePath = Form("%s%s",FolderPath.c_str(),fileNamesVec[f].c_str());
                cout << "file path: " << FilePath << endl;

                if (!util->isBranchPresentInFile(FilePath, "Events/T0")) {
                        continue;
                }

                // --- Open file and tree ---
                TFile* file = TFile::Open(FilePath.c_str(), "READ");
                TTree* tree = (TTree*)file->Get("Events/T0");

                // One branch per pixel, each is a vector<int> of 200 timebins
                const int nPixels = 256;
                const int timebin = 100;
                std::vector<int>* vFADCTraces[nPixels] = {};
                for (int pix = 0; pix < nPixels; pix++) {
                        tree->SetBranchAddress(Form("vFADCTraces%d", pix), &vFADCTraces[pix]);
                }

                int CameraStep = 16;
                float CameraMin = -0.5;
                float CameraMax = 15.5;

                int nEntries = tree->GetEntries();
                for (int ev = 0; ev < nEntries; ev++) {
                        tree->GetEntry(ev);

                        TH2F* hPhotonDist1xPixels = new TH2F(
                                Form("hPhotonDist1xPixels_ev%d", ev),
                                "Camera View;Pixels along camera x axis;Pixels along camera y axis;ADC Counts",
                                CameraStep, CameraMin, CameraMax,
                                CameraStep, CameraMin, CameraMax);

                        for (int pix = 0; pix < nPixels; pix++) {
                                if (!vFADCTraces[pix]) continue;
                                float val = ((int)vFADCTraces[pix]->size() > timebin)
                                                ? (*vFADCTraces[pix])[timebin]
                                                : 0.0f;
                                int nx, ny;
                                plottools->FindBin(pix, &nx, &ny);
                                hPhotonDist1xPixels->SetBinContent(nx + 1, ny + 1, val);
                        }

                        // --- Output plots file ---
                        fileOutputPlots = new TFile(
                                Form("%s%s/plots_%s_ev%d_%s",
                                     outDir.c_str(), folString.c_str(),
                                     simrun.c_str(), ev, fileNamesVec[f].c_str()),
                                "RECREATE");

                        canvas = new TCanvas("Display","Event Display",1200,1000);
                        canvas->SetRightMargin(0.15);
                        hPhotonDist1xPixels->SetMarkerSize(200.0);
                        hPhotonDist1xPixels->SetStats(0);
                        hPhotonDist1xPixels->Draw("colz");
                        hPhotonDist1xPixels->GetZaxis()->SetTitleOffset(1.4);
                        plottools->DrawSIABBoundaries();
                        hPhotonDist1xPixels->Write(Form("h%sPixels_ev%d", fileNamesVec[f].c_str(), ev));
                        canvas->Write(Form("C%sPixels_ev%d", fileNamesVec[f].c_str(), ev));
                        fileOutputPlots->Close();

                        // --- Output data file ---
                        fileOutput = new TFile(
                                Form("%s%s/%s_ev%d_%s",
                                     outDir.c_str(), folString.c_str(),
                                     simrun.c_str(), ev, fileNamesVec[f].c_str()),
                                "RECREATE");

                        create_root_file(hPhotonDist1xPixels, fileOutput);
                        fileOutput->Close();

                        delete hPhotonDist1xPixels;
                        delete fileOutput;
                        delete fileOutputPlots;
                        delete canvas;

                        util->setFilePermissions(Form("%s%s/%s_ev%d_%s",
                                outDir.c_str(), folString.c_str(),
                                simrun.c_str(), ev, fileNamesVec[f].c_str()));
                        util->setFilePermissions(Form("%s%s/plots_%s_ev%d_%s",
                                outDir.c_str(), folString.c_str(), 
                                simrun.c_str(),ev, fileNamesVec[f].c_str()));
                }

                file->Close();
                delete file;
        }
        cout << "Completed!" << endl;   
}


void create_root_file(TH2F* hist, TFile* file) {

    TTree *tree = new TTree("Test", "Events tree");

    ev = new IEvent();

    ev->SetCoBoTime(ULong64_t(174000000000000ULL));
    ev->SetUNIXTime(ULong64_t(0ULL));
    ev->SetTBTime(ULong64_t(174000000000000ULL));
    ev->SetEventType(ULong64_t(3));

    std::vector<vector<Int_t>> pixels;
    for(int i = 0; i < 256; i++){
        std::vector<Int_t> trace;    
        for(int j = 0; j < 512; j++) {
            trace.push_back(160);
        }
        int nx, ny;
        plottools->FindBin(i, &nx, &ny);
        double binVal = hist->GetBinContent(nx + 1, ny + 1);
        trace[239] = (binVal > 160) ? 0 : (int)(160.0 - binVal);
        pixels.push_back(trace);
    }
    ev->SetSignalValue(pixels);

    int maxBinX, maxBinY, dummy;
    hist->GetMaximumBin(maxBinX, maxBinY, dummy);
    int MusicID = plottools->FindMUSIC(maxBinX - 1, maxBinY - 1);

    ev->SetROIMusicID({MusicID, -1});
    ev->SetROIPixelID({1});
    std::vector<float> temp = {1.0};
    std::string temp_str = "";
    ev->SetParametersFromTimestamp(temp_str,temp,temp,temp,temp,temp,temp,temp,temp,temp,temp,temp,temp,temp,temp,temp,temp,temp,temp);
    
    tree->Branch("Events","IEvent",ev);
    tree->Fill();
    file->Write();
    delete ev;
    delete tree;
}
