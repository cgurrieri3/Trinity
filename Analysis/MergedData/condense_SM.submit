container_image = /storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/containers/rootandexact.sif

# Ensure host paths are visible inside the container
#+ApptainerBind = "/storage,/tmp,/dev,/proc,/exact"


executable = run_condor.sh
 # name of the bash script or python or root 

arguments = $(Date) $(Filename)

# Keep your environment variables
#getenv = False

log = /storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/MergedData/.logs/HT_condor_$(Date)_$(Filename).log 
# HTCondor log

error = /storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/MergedData/.logs/Program_$(Date)_$(Filename).err 
#Standard Error - program and HTCondor errors

output = /storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/MergedData/.logs/Program_$(Date)_$(Filename).out 
# program terminal output (not output files)


transfer_input_files = /storage/osg-otte1/shared/TrinityDemonstrator/Data/$(Date)/RawDataMerged/$(Filename),/storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/MergedData/scripts/MergeData/FileMerge,/storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/MergedData/scripts/IncludeCalibrationData/AddCalibData, /storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/MergedData/run_condor.sh,/storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/containers/rootandexact.sif,/storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/AncillaryData/Data2/statemessages$(Date).csv,/storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/AncillaryData/Data1/celestialPositions$(Date).csv,/storage/osg-otte1/shared/TrinityDemonstrator/MiscData/WeatherData/weather/weather_$(Date),/storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/exact/data/SiPMTempatureCorrections.csv,,/storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/exact/data/UCTempatureCorrections.csv
#any file that needs to included for the job - everything minus executable



should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
transfer_output_files = DataAnalysis/MergedData/Output/$(Date)/


request_cpus = 1
 # these are PER JOB

request_memory = 4GB 
# these are PER JOB

# space for all files input and output and intermediate files
request_disk = 5GB 
# these are PER JOB

# Tell HTCondor to run 3 instances of our job:
###----------#####
# Queue! HAS TO BE THE LAST LINE
###----------#####
# MAGICAL
# synatax 
# queue + num - que this many identical jobs (EXACT  SAME JOB)
# use case - executable can create independent jobs (script creates difference between jobs)
# randomw number simulations 
queue 1
 

